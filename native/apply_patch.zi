// Locate a patch hunk's lines in a file, exactly as codex-apply-patch's
// seek_sequence did in Rust. Lines arrive as UTF-8 pointers and byte lengths
// borrowed from the caller; nothing is copied or allocated.
using U :: #import "std/utf8";
using B :: #import "std/byte_text_linux";

libc :: #system_library "libc";
CompareRaw :: (left: *u8, right: *u8, count: usize) -> s32 #foreign libc "memcmp";
CopyRaw :: (target: *u8, source: *u8, count: usize) -> *void #foreign libc "memcpy";

// Unicode White_Space, the set Rust's str::trim and char::is_whitespace use.
IsWhiteSpace :: (point: u32) -> bool {
    if point < cast(u32)128 {
        return point == cast(u32)32 || (point >= cast(u32)9 && point <= cast(u32)13)
    }
    return point == cast(u32)133 || point == cast(u32)160 || point == cast(u32)5760 ||
           (point >= cast(u32)8192 && point <= cast(u32)8202) ||
           point == cast(u32)8232 || point == cast(u32)8233 || point == cast(u32)8239 ||
           point == cast(u32)8287 || point == cast(u32)12288
}

IsAsciiSpace :: (byte: u8) -> bool {
    return byte == cast(u8)32 || (byte >= cast(u8)9 && byte <= cast(u8)13)
}

// Typographic punctuation and odd spaces compared as their ASCII forms.
Normal :: (point: u32) -> u32 {
    if point < cast(u32)160 { return point }
    if (point >= cast(u32)8208 && point <= cast(u32)8213) || point == cast(u32)8722 { return cast(u32)45 }
    if point >= cast(u32)8216 && point <= cast(u32)8219 { return cast(u32)39 }
    if point >= cast(u32)8220 && point <= cast(u32)8223 { return cast(u32)34 }
    if point == cast(u32)160 || (point >= cast(u32)8194 && point <= cast(u32)8202) ||
       point == cast(u32)8239 || point == cast(u32)8287 || point == cast(u32)12288 { return cast(u32)32 }
    return point
}

Text :: (data: *u8, length: s64) -> string {
    return B.TextFromBytes(B.BytesFromPointer(data, cast(u64)length))
}

// First byte after leading whitespace in text[0:end].
TrimStart :: (text: string, end: s32) -> s32 {
    at: s32 = 0
    while at < end {
        byte := text[at]
        if byte < cast(u8)128 {
            if !IsAsciiSpace(byte) { return at }
            at += 1
        } else {
            decoded := U.Decode(text, at)
            if !IsWhiteSpace(decoded.value) { return at }
            at = decoded.after
        }
    }
    return end
}

// End of text once trailing whitespace is removed, scanning back from the end.
TrimEnd :: (text: string, end: s32) -> s32 {
    at := end
    while at > 0 {
        byte := text[at - 1]
        if byte < cast(u8)128 {
            if !IsAsciiSpace(byte) { return at }
            at -= 1
        } else {
            lead := at - 1
            while lead > 0 && (text[lead] & cast(u8)192) == cast(u8)128 { lead -= 1 }
            if !IsWhiteSpace(U.Decode(text, lead).value) { return at }
            at = lead
        }
    }
    return 0
}

SameBytes :: (left: *u8, a: s32, a_end: s32, right: *u8, b: s32, b_end: s32) -> bool {
    count := a_end - a
    if count != b_end - b { return false }
    if count == 0 { return true }
    return CompareRaw(*left[a], *right[b], cast(usize)count) == 0
}

SameNormal :: (left: string, a: s32, a_end: s32, right: string, b: s32, b_end: s32) -> bool {
    i := a
    j := b
    while i < a_end && j < b_end {
        first := left[i]
        second := right[j]
        if first < cast(u8)128 && second < cast(u8)128 {
            if first != second { return false }
            i += 1
            j += 1
        } else {
            one := U.Decode(left, i)
            two := U.Decode(right, j)
            if Normal(one.value) != Normal(two.value) { return false }
            i = one.after
            j = two.after
        }
    }
    return i >= a_end && j >= b_end
}

// Mode 0 exact, 1 trim_end, 2 trim, 3 trim and normalized punctuation.
SameLine :: (left: *u8, left_length: s64, right: *u8, right_length: s64, mode: s32) -> bool {
    a_end := cast(s32)left_length
    b_end := cast(s32)right_length
    if mode == 0 { return SameBytes(left, 0, a_end, right, 0, b_end) }
    one := Text(left, left_length)
    two := Text(right, right_length)
    a_end = TrimEnd(one, a_end)
    b_end = TrimEnd(two, b_end)
    if mode == 1 { return SameBytes(left, 0, a_end, right, 0, b_end) }
    a := TrimStart(one, a_end)
    b := TrimStart(two, b_end)
    if mode == 2 { return SameBytes(left, a, a_end, right, b, b_end) }
    return SameNormal(one, a, a_end, two, b, b_end)
}

// The first index at or after start where every pattern line matches, trying
// each mode over the whole range before relaxing to the next; -1 when none
// matches, -2 for invalid arguments.
#program_export
xcoder_seek_sequence :: (lines: **u8, line_lengths: *s64, line_count: s64, pattern: **u8, pattern_lengths: *s64, pattern_count: s64, start: s64, eof: s32) -> s64 {
    if line_count < 0 || pattern_count < 0 || start < 0 { return -2 }
    if pattern_count == 0 { return start }
    if pattern_count > line_count { return -1 }
    if lines == null || line_lengths == null || pattern == null || pattern_lengths == null { return -2 }
    return Seek(lines, line_lengths, line_count, pattern, pattern_lengths, pattern_count, start, eof)
}

Seek :: (lines: **u8, line_lengths: *s64, line_count: s64, pattern: **u8, pattern_lengths: *s64, pattern_count: s64, start: s64, eof: s32) -> s64 {
    if pattern_count == 0 { return start }
    if pattern_count > line_count { return -1 }
    last := line_count - pattern_count
    search := start
    if eof != 0 && last > start { search = last }
    mode: s32 = 0
    while mode < 4 {
        index := search
        while index <= last {
            matched := true
            offset: s64 = 0
            while matched && offset < pattern_count {
                line := index + offset
                matched = SameLine(lines[line], line_lengths[line], pattern[offset], pattern_lengths[offset], mode)
                offset += 1
            }
            if matched { return index }
            index += 1
        }
        mode += 1
    }
    return -1
}

// ---------------------------------------------------------------------------
// Applying an update: the whole of derive_new_contents_from_chunks between
// reading the file and diffing it. Lines are offsets into the original bytes,
// and the new contents are written once into the caller's buffer.

Lf :: 1
CrLf :: 2
Cr :: 3

// A chunk record is eight values: change-context string or -1, first and
// count of its old lines, first and count of its new lines (indices into the
// strings table), first and count of its context pairs, end-of-file flag.
ChunkFields :: 8
// A replacement is four values: first file line, lines replaced, first new
// string, new string count.
ReplacementFields :: 4

Ending :: (ending: s32, preferred: s32) -> s32 {
    return ifx ending == 0 then preferred else ending
}

WriteEnding :: (output: *u8, at: s64, ending: s32) -> s64 {
    if ending == CrLf {
        output[at] = cast(u8)13
        output[at + 1] = cast(u8)10
        return at + 2
    }
    output[at] = ifx ending == Cr then cast(u8)13 else cast(u8)10
    return at + 1
}

WriteBytes :: (output: *u8, at: s64, data: *u8, count: s64) -> s64 {
    if count > 0 { unused CopyRaw(*output[at], data, cast(usize)count) }
    return at + count
}

Push :: (replacements: *s64, count: s64, capacity: s64, start: s64, old_count: s64, new_first: s64, new_count: s64) -> s64 {
    if count >= capacity { return -1 }
    record := count * ReplacementFields
    replacements[record] = start
    replacements[record + 1] = old_count
    replacements[record + 2] = new_first
    replacements[record + 3] = new_count
    return count + 1
}

// Stable insertion sort by first file line, as Rust's sort_by_key.
SortReplacements :: (replacements: *s64, count: s64) {
    index: s64 = 1
    while index < count {
        start := replacements[index * ReplacementFields]
        old_count := replacements[index * ReplacementFields + 1]
        new_first := replacements[index * ReplacementFields + 2]
        new_count := replacements[index * ReplacementFields + 3]
        at := index
        while at > 0 && replacements[(at - 1) * ReplacementFields] > start {
            for field: 0..ReplacementFields - 1 {
                replacements[at * ReplacementFields + field] = replacements[(at - 1) * ReplacementFields + field]
            }
            at -= 1
        }
        replacements[at * ReplacementFields] = start
        replacements[at * ReplacementFields + 1] = old_count
        replacements[at * ReplacementFields + 2] = new_first
        replacements[at * ReplacementFields + 3] = new_count
        index += 1
    }
}

// Writes the patched file into output and returns its length. -1: a change
// context was not found; -2: a chunk's old lines were not found (failed_chunk
// names the chunk); -3: invalid arguments or a buffer too small.
#program_export
xcoder_apply_chunks :: (contents: *u8, contents_length: s64,
                        line_data: **u8, line_lengths: *s64, line_endings: *s32, line_capacity: s64,
                        strings: **u8, string_lengths: *s64, string_count: s64,
                        chunks: *s64, chunk_count: s64, pairs: *s64,
                        replacements: *s64, replacement_capacity: s64,
                        output: *u8, output_capacity: s64, failed_chunk: *s64) -> s64 {
    if contents_length < 0 || line_capacity < 1 || chunk_count < 0 || failed_chunk == null ||
       line_data == null || line_lengths == null || line_endings == null ||
       (contents_length > 0 && contents == null) || (chunk_count > 0 && chunks == null) ||
       (string_count > 0 && (strings == null || string_lengths == null)) ||
       replacements == null || output == null { return -3 }

    // Split into lines; each line's ending is kept, the first one is preferred.
    line_count: s64 = 0
    preferred: s32 = 0
    line_start: s64 = 0
    cursor: s64 = 0
    while cursor < contents_length {
        byte := contents[cursor]
        ending: s32 = 0
        width: s64 = 1
        if byte == cast(u8)10 {
            ending = Lf
        } else if byte == cast(u8)13 {
            ending = Cr
            if cursor + 1 < contents_length && contents[cursor + 1] == cast(u8)10 {
                ending = CrLf
                width = 2
            }
        }
        if ending == 0 {
            cursor += 1
        } else {
            if line_count >= line_capacity { return -3 }
            if preferred == 0 { preferred = ending }
            line_data[line_count] = *contents[line_start]
            line_lengths[line_count] = cursor - line_start
            line_endings[line_count] = ending
            line_count += 1
            cursor += width
            line_start = cursor
        }
    }
    if line_start < contents_length {
        if line_count >= line_capacity { return -3 }
        line_data[line_count] = *contents[line_start]
        line_lengths[line_count] = contents_length - line_start
        line_endings[line_count] = 0
        line_count += 1
    }
    if preferred == 0 { preferred = Lf }

    // Find every chunk, exactly as compute_replacements did.
    count: s64 = 0
    line_index: s64 = 0
    chunk: s64 = 0
    while chunk < chunk_count {
        record := chunk * ChunkFields
        context := chunks[record]
        old_first := chunks[record + 1]
        old_count := chunks[record + 2]
        new_first := chunks[record + 3]
        new_count := chunks[record + 4]
        pair_first := chunks[record + 5]
        pair_count := chunks[record + 6]
        eof := cast(s32)chunks[record + 7]
        if context >= string_count || old_first < 0 || old_count < 0 || new_first < 0 || new_count < 0 ||
           old_first + old_count > string_count || new_first + new_count > string_count ||
           pair_first < 0 || pair_count < 0 || (pair_count > 0 && pairs == null) { return -3 }
        if context >= 0 {
            found := Seek(line_data, line_lengths, line_count, *strings[context], *string_lengths[context], 1, line_index, 0)
            if found < 0 {
                failed_chunk.* = chunk
                return -1
            }
            line_index = found + 1
        }
        if old_count == 0 {
            count = Push(replacements, count, replacement_capacity, line_count, 0, new_first, new_count)
            if count < 0 { return -3 }
        } else {
            pattern_count := old_count
            kept_new := new_count
            found := Seek(line_data, line_lengths, line_count, *strings[old_first], *string_lengths[old_first], pattern_count, line_index, eof)
            if found < 0 && string_lengths[old_first + old_count - 1] == 0 {
                pattern_count -= 1
                if kept_new > 0 && string_lengths[new_first + kept_new - 1] == 0 { kept_new -= 1 }
                found = Seek(line_data, line_lengths, line_count, *strings[old_first], *string_lengths[old_first], pattern_count, line_index, eof)
            }
            if found < 0 {
                failed_chunk.* = chunk
                return -2
            }
            old_start: s64 = 0
            new_start: s64 = 0
            pair: s64 = 0
            searching := true
            while searching && pair < pair_count {
                old_context := pairs[(pair_first + pair) * 2]
                new_context := pairs[(pair_first + pair) * 2 + 1]
                if old_context >= pattern_count || new_context >= kept_new {
                    searching = false
                } else {
                    if old_start != old_context || new_start != new_context {
                        count = Push(replacements, count, replacement_capacity, found + old_start,
                                     old_context - old_start, new_first + new_start, new_context - new_start)
                        if count < 0 { return -3 }
                    }
                    old_start = old_context + 1
                    new_start = new_context + 1
                    pair += 1
                }
            }
            if old_start != pattern_count || new_start != kept_new {
                count = Push(replacements, count, replacement_capacity, found + old_start,
                             pattern_count - old_start, new_first + new_start, kept_new - new_start)
                if count < 0 { return -3 }
            }
            line_index = found + pattern_count
        }
        chunk += 1
    }
    SortReplacements(replacements, count)

    // Write the result: kept lines keep their endings, inserted lines and a
    // last line without one get the preferred ending. As Rust's
    // apply_replacements, `position` is how far the source lines were consumed
    // and `logical` where the previous replacement ended; an overlapping
    // replacement (start before logical) keeps every remaining line, as the
    // wrapping subtraction in Rust's release build did.
    at: s64 = 0
    position: s64 = 0
    logical: s64 = 0
    replacement: s64 = 0
    while replacement < count {
        record := replacement * ReplacementFields
        start := replacements[record]
        old_lines := replacements[record + 1]
        keep_until := ifx start >= logical then position + (start - logical) else line_count
        if keep_until > line_count { keep_until = line_count }
        while position < keep_until {
            if at + line_lengths[position] + 2 > output_capacity { return -3 }
            at = WriteBytes(output, at, line_data[position], line_lengths[position])
            at = WriteEnding(output, at, Ending(line_endings[position], preferred))
            position += 1
        }
        position += old_lines
        if position > line_count { position = line_count }
        new_line := replacements[record + 2]
        new_end := new_line + replacements[record + 3]
        while new_line < new_end {
            if at + string_lengths[new_line] + 2 > output_capacity { return -3 }
            at = WriteBytes(output, at, strings[new_line], string_lengths[new_line])
            at = WriteEnding(output, at, preferred)
            new_line += 1
        }
        logical = start + old_lines
        replacement += 1
    }
    while position < line_count {
        if at + line_lengths[position] + 2 > output_capacity { return -3 }
        at = WriteBytes(output, at, line_data[position], line_lengths[position])
        at = WriteEnding(output, at, Ending(line_endings[position], preferred))
        position += 1
    }
    return at
}
